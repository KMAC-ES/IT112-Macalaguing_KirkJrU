#include <stdio.h>
 
int main() {
    int number;
    int totalSum = 0;
 
    printf("Enter positive numbers to ADD (zero or negative number to STOP)\n\n");
 
    for (;;) {
        printf("Enter a number: ");
        scanf("%d", &number);
 
        if (number <= 0) {
            printf("Total sum is: %d\n", totalSum);
            break;
        }
 
        totalSum += number;
    }
 
    return 0;
}
