#include <stdio.h>
 
int main() {
    char name[100];
    char section[50];
    float q1, q2, q3, q4;
    float average;
 
    printf("Enter Complete Name: ");
    fgets(name, sizeof(name), stdin);
 
    printf("Enter Section : ");
    fgets(section, sizeof(section), stdin);
 
    printf("\n");
    printf("Enter 1st Quarter Grade: ");
    scanf("%f", &q1);
    printf("Enter 2nd Quarter Grade: ");
    scanf("%f", &q2);
    printf("Enter 3rd Quarter Grade: ");
    scanf("%f", &q3);
    printf("Enter 4th Quarter Grade: ");
    scanf("%f", &q4);
 
    average = (q1 + q2 + q3 + q4) / 4.0;
 
    printf("\n");
    printf("Student: %s\n", name);
    printf("Section: %s\n", section);
    printf("General Average: %.2f\n", average);
    printf("Remarks: ");
 
    if (average >= 90) {
        printf("Outstanding\n");
    } else if (average >= 85) {
        printf("Very Satisfactory\n");
    } else if (average >= 80) {
        printf("Satisfactory\n");
    } else if (average >= 75) {
        printf("Fair\n");
    } else {
        printf("Failed\n");
    }
 
    return 0;
}
