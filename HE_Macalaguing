#include <stdio.h>

#define MIN_BALANCE 100.00
#define INQUIRY_FEE 2.00
#define WITHDRAW_FEE 15.00

int main(void)
{
    double balance = 500.00;
    double amount;
    int choice;

    do {
        printf("BSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            while (getchar() != '\n');
            printf("Invalid input. Please enter a number from 1 to 4.\n\n");
            choice = 0;
            continue;
        }

        switch (choice) {
            case 1:
                if (balance - INQUIRY_FEE < MIN_BALANCE) {
                    printf("\nYour current balance: P%.2f\n", balance);
                    printf("(Inquiry fee waived: balance must stay at least P100.00)\n\n");
                } else {
                    balance -= INQUIRY_FEE;
                    printf("\nA P%.2f inquiry fee has been charged.\n", INQUIRY_FEE);
                    printf("Your current balance: P%.2f\n\n", balance);
                }
                break;

            case 2:
                printf("Enter amount to deposit: ");
                if (scanf("%lf", &amount) != 1 || amount <= 0) {
                    while (getchar() != '\n');
                    printf("Invalid amount. Deposit must be greater than 0.\n\n");
                } else {
                    balance += amount;
                    printf("P%.2f deposited successfully!\n\n", amount);
                }
                break;

            case 3:
                printf("Enter amount to withdraw: ");
                if (scanf("%lf", &amount) != 1 || amount <= 0) {
                    while (getchar() != '\n');
                    printf("Invalid amount. Withdrawal must be greater than 0.\n\n");
                } else if (balance - amount - WITHDRAW_FEE < MIN_BALANCE) {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account.\n\n");
                } else {
                    balance -= (amount + WITHDRAW_FEE);
                    printf("You withdrew P%.2f successfully!\n", amount);
                    printf("A P%.2f withdrawal fee has been charged.\n\n", WITHDRAW_FEE);
                }
                break;

            case 4:
                printf("Thank you for banking with BSIT BANK. Goodbye!\n");
                break;

            default:
                printf("Invalid choice. Please select from 1 to 4.\n\n");
        }
    } while (choice != 4);

    return 0;
}
